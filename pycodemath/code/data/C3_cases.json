{
 "description": "C3 evaluation set: value ranges and overflow/underflow/NaN/precision-loss events. 'expect' maps an event class to the required class status: 'confirmed' (some node has the event, witnessed by execution), 'proved_safe' (no node can have it). Held-out cases (split=held) are evaluated only after the analyzer is frozen.",
 "licence": "Cases are written for this repository (MIT). 'source' links only document the real-world incident or fact a case is modelled on; no text or data is copied from them.",
 "cases": [
  {
   "id": "bsearch_mid_int32",
   "expr": "(lo + hi) // 2",
   "dtype": "int32",
   "ranges": {
    "lo": [
     "0",
     "2**31-1"
    ],
    "hi": [
     "0",
     "2**31-1"
    ]
   },
   "real_problem": true,
   "target": "overflow",
   "expect": {
    "overflow": "confirmed"
   },
   "story": "Binary-search midpoint in the JDK and Programming Pearls (Bloch 2006).",
   "source": "https://research.google/blog/extra-extra-read-all-about-it-nearly-all-binary-searches-and-mergesorts-are-broken/",
   "split": "dev"
  },
  {
   "id": "bsearch_mid_fixed_int32",
   "expr": "lo + (hi - lo) // 2",
   "dtype": "int32",
   "ranges": {
    "lo": [
     "0",
     "2**31-1"
    ],
    "hi": [
     "0",
     "2**31-1"
    ]
   },
   "real_problem": false,
   "target": "overflow",
   "expect": {
    "overflow": "proved_safe"
   },
   "story": "Bloch's fix; never overflows even without lo <= hi.",
   "source": "https://research.google/blog/extra-extra-read-all-about-it-nearly-all-binary-searches-and-mergesorts-are-broken/",
   "split": "dev"
  },
