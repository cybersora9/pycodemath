{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cybersora9/pycodemath",
  "title": "Pycodemath",
  "description": "Checks the math in your code and gives AI agents an exact math engine (SymPy + NumPy).",
  "repository": {
    "url": "https://github.com/cybersora9/pycodemath",
    "source": "github"
  },
  "websiteUrl": "https://cybersora.pl",
  "version": "0.5.2",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "pycodemath",
      "version": "0.5.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=1.0,<2.0"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
